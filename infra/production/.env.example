# Preparation only. Copy to a private .env on the future server; never commit it.
# Empty values intentionally fail Compose rendering until an operator fills them.
API_IMAGE=
CADDY_IMAGE=
API_DOMAIN=
IDENTITY_DOMAIN=
# Existing Vercel dashboard origin, without trailing slash; no frontend move.
WEB_ORIGIN=
# Exact https://<dashboard>/api/v1/auth/callback through the same-origin proxy.
OIDC_CALLBACK_URL=
# Use URL-safe random application DB password (embedded in DATABASE_URL).
APP_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
IDENTITY_SECRET=
IDENTITY_EVENT_SECRET=
# Exact shared issuer and public endpoints from reviewed authentik metadata.
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_JWKS_URL=
# Both confidential providers currently require this same secret.
OIDC_CLIENT_SECRET=
# Existing private managed/S3-compatible service; this stack provisions no S3.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
# Verified external mail service supporting authenticated STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
